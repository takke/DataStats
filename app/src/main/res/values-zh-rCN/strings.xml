    <string name="desc_text_size">悬浮窗文字的字体大小</string>
    <string name="desc_pos">悬浮窗的水平位置</string>
    <string name="desc_unit_type">选择速度显示的单位</string>
    <string name="desc_bar_max_kb">速度条充满时对应的最大速度</string>
    <string name="desc_logarithm_bar">以对数刻度显示速度条</string>
    <string name="desc_hide_when_in_fullscreen">全屏应用运行时自动隐藏</string>
    <string name="desc_interval">悬浮窗更新周期。屏幕关闭时服务将自动暂停，因此更长的间隔仅在屏幕开启时节省电量。</string>
    <string name="desc_interpolate">在两次采样之间平滑动画(耗电增加)</string>
    <string name="desc_sparkline">在悬浮窗上叠加显示最近 1 分钟的流量迷你图</string>
    <string name="desc_show_only_on_mobile">仅在使用移动数据连接时显示速度表(Wi-Fi、以太网、VPN 视为非移动)。</string>
    <string name="desc_mobile_only_meter">排除 Wi-Fi，仅测量移动数据流量。适合关注按流量计费网络的使用情况。</string>
    <string name="desc_show_network_type_icon">在速度表上绘制表示当前网络的一个字符: W (Wi-Fi) / M (移动) / E (以太网) / V (VPN)。</string>
    <string name="desc_auto_unit_scale">速度超过 1 MB/s 时自动切换为 MB/s、GB/s(或 Mbps/Gbps)。高速连接下也能保持紧凑显示。</string>
    <string name="desc_auto_start_on_boot">设备启动时自动启动服务。屏幕关闭时服务将自动暂停以节省电量。</string>

    <string name="preview_hint">拖动滑块或点击示例按钮，将预览值注入悬浮窗</string>
    <string name="preview_live_mode">实时流量显示</string>
    <string name="preview_live_mode_desc">实时显示当前的网络流量。关闭后可通过滑块或示例按钮注入预览值。</string>
    <string name="preview_live_upload">上传</string>
