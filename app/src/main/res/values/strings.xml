    <!-- Setting descriptions -->
    <string name="desc_text_size">Font size of the overlay text</string>
    <string name="desc_pos">Horizontal position of the overlay</string>
    <string name="desc_unit_type">Choose the unit for the speed display</string>
    <string name="desc_bar_max_kb">Maximum speed represented by the full bar</string>
    <string name="desc_logarithm_bar">Display the bar on a logarithmic scale</string>
    <string name="desc_hide_when_in_fullscreen">Automatically hide while a fullscreen app is running</string>
    <string name="desc_interval">Overlay refresh interval. The service automatically pauses while the screen is off, so a longer interval saves battery only while the screen is on.</string>
    <string name="desc_interpolate">Smoothly animate between samples (higher battery usage)</string>
    <string name="desc_sparkline">Overlay a mini graph of the last minute\'s traffic on the meter</string>
    <string name="desc_show_only_on_mobile">Hide the meter unless the device is on a mobile data connection (Wi-Fi, Ethernet and VPN are treated as non-mobile).</string>
    <string name="desc_mobile_only_meter">Measure only mobile data traffic (Wi-Fi is excluded). Useful for tracking metered connection usage.</string>
    <string name="desc_show_network_type_icon">Draw a small letter on the meter indicating the current network: W (Wi-Fi) / M (Mobile) / E (Ethernet) / V (VPN).</string>
    <string name="desc_auto_unit_scale">Automatically switch to MB/GB (or Mbps/Gbps) when the speed exceeds 1 MB/s. Keeps the display compact on fast connections.</string>
    <string name="desc_auto_start_on_boot">Start the service automatically when the device boots. When the screen turns off the service automatically pauses to save battery.</string>

    <string name="preview_hint">Drag the slider or tap a sample to inject a preview value into the overlay</string>
    <string name="preview_live_mode">Live traffic</string>
    <string name="preview_live_mode_desc">Show the current network traffic in real time. Turn off to inject preview values with a slider or sample buttons.</string>
